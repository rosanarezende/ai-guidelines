{
  "name": "ai-guidelines",
  "version": "1.1.0",
  "description": "Portable AI governance framework — agnostic by design",
  "license": "Apache-2.0",
  "homepage": "https://github.com/rosanarezende/ai-guidelines#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rosanarezende/ai-guidelines.git"
  },
  "bugs": {
    "url": "https://github.com/rosanarezende/ai-guidelines/issues"
  },
  "keywords": [
    "ai",
    "governance",
    "agents",
    "claude",
    "copilot",
    "cli"
  ],
  "bin": "cli/ai-guidelines-cli.mjs",
  "imports": {
    "#app/*": "./cli/app/*.mjs",
    "#cli/*": "./cli/cli/*.mjs",
    "#features/*": "./cli/features/*.mjs",
    "#formatters/*": "./cli/formatters/*.mjs",
    "#governance/*": "./cli/governance/*.mjs",
    "#governance/monolith/*": "./cli/governance/monolith/*.mjs",
    "#fs/*": "./cli/fs/*.mjs"
  },
  "files": [
    "cli",
    "!cli/**/*.test.mjs",
    "!cli/**/__fixtures__",
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/__fixtures__",
    ".core",
    ".specify/templates",
    "docs",
    "!docs/assets",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "guidelines": "node cli/ai-guidelines-cli.mjs",
    "guidelines:init": "node cli/ai-guidelines-cli.mjs init",
    "guidelines:adopt": "node cli/ai-guidelines-cli.mjs adopt",
    "guidelines:providers": "node cli/ai-guidelines-cli.mjs providers",
    "setup": "yarn install --immutable && yarn build:all",
    "build": "tsc",
    "build:rules": "node cli/governance/monolith/rules-builder.mjs",
    "build:all": "yarn build && yarn build:rules",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "yarn test:unit && yarn test:ts",
    "test:unit": "node --experimental-default-config-file --test cli/**/*.test.mjs cli/**/**/*.test.mjs tests/integration/**/*.test.mjs",
    "test:ts": "jest --config ./.jest/jest.config.js",
    "test:smoke": "yarn build && node --experimental-default-config-file --test tests/smoke/*.test.mjs",
    "test:coverage": "node --experimental-default-config-file --experimental-test-coverage --test cli/**/*.test.mjs cli/**/**/*.test.mjs tests/integration/**/*.test.mjs && jest --config ./.jest/jest.config.js --coverage",
    "living-docs:generate": "yarn build && node cli/living-docs.mjs generate",
    "living-docs:check": "yarn build && node cli/living-docs.mjs check",
    "state-yml:check": "yarn build && node cli/state-yml-check.mjs",
    "gate-decidability:check": "node cli/governance/gate-decidability-check.mjs",
    "validate": "yarn format:check && yarn build:all && yarn test && yarn living-docs:check && yarn state-yml:check && yarn gate-decidability:check",
    "ci": "yarn install --immutable && yarn validate && yarn test:smoke",
    "prepare": "husky",
    "prepack": "yarn build:all"
  },
  "devDependencies": {
    "@inquirer/testing": "^3.3.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.6.2",
    "@types/yaml": "^1.9.7",
    "husky": "^9.1.7",
    "jest": "^30.4.2",
    "jest-util": "^30.4.1",
    "lint-staged": "^17.0.5",
    "prettier": "^3.0.0",
    "ts-jest": "^29.4.9",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  },
  "packageManager": "yarn@4.1.1",
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@inquirer/prompts": "7.8.4",
    "yaml": "^2.8.4"
  }
}
