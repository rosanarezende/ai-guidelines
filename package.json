{
  "name": "ai-guidelines",
  "version": "1.1.0",
  "description": "Portable AI governance framework — agnostic by design",
  "license": "Apache-2.0",
  "homepage": "https://github.com/rosanarezende/ai-guidelines#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rosanarezende/ai-guidelines.git"
  },
  "bugs": {
    "url": "https://github.com/rosanarezende/ai-guidelines/issues"
  },
  "keywords": [
    "ai",
    "governance",
    "agents",
    "claude",
    "copilot",
    "cli"
  ],
  "bin": "cli/ai-guidelines-cli.mjs",
  "imports": {
    "#app/*": "./cli/app/*.mjs",
    "#cli/*": "./cli/cli/*.mjs",
    "#features/*": "./cli/features/*.mjs",
    "#formatters/*": "./cli/formatters/*.mjs",
    "#governance/*": "./cli/governance/*.mjs",
    "#governance/monolith/*": "./cli/governance/monolith/*.mjs",
    "#fs/*": "./cli/fs/*.mjs"
  },
  "files": [
    "cli",
    "!cli/**/*.test.mjs",
    "!cli/**/__fixtures__",
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/__fixtures__",
    ".core",
    ".specify/templates",
    "docs",
    "!docs/assets",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "guidelines": "node cli/ai-guidelines-cli.mjs",
    "guidelines:init": "node cli/ai-guidelines-cli.mjs init",
    "guidelines:adopt": "node cli/ai-guidelines-cli.mjs adopt",
    "guidelines:providers": "node cli/ai-guidelines-cli.mjs providers",
    "setup": "npm ci && npm run build:all",
    "build": "tsc",
    "build:rules": "node cli/rules-build.mjs",
    "build:all": "npm run build && npm run build:rules",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint-staged": "lint-staged",
    "test": "npm run test:unit && npm run test:ts",
    "test:unit": "node --experimental-default-config-file --test \"cli/**/*.test.mjs\" \"tests/integration/**/*.test.mjs\"",
    "test:ts": "jest --config ./.jest/jest.config.js",
    "test:smoke": "npm run build && node --experimental-default-config-file --test \"tests/smoke/*.test.mjs\"",
    "test:coverage": "node --experimental-default-config-file --experimental-test-coverage --test \"cli/**/*.test.mjs\" \"tests/integration/**/*.test.mjs\" && jest --config ./.jest/jest.config.js --coverage",
    "living-docs:generate": "npm run build && node cli/living-docs.mjs generate",
    "living-docs:check": "npm run build && node cli/living-docs.mjs check",
    "state-yml:check": "npm run build && node cli/state-yml-check.mjs",
    "state-yml:check:all": "npm run build && node cli/state-yml-check.mjs --all",
    "active-specs:check": "npm run build && node cli/active-specs-check.mjs",
    "reconcile:check": "npm run build && node cli/reconcile-check.mjs",
    "co-knowledge:check": "npm run build && node cli/co-knowledge-check.mjs",
    "co-knowledge:inventory": "npm run build && node cli/co-knowledge-inventory.mjs",
    "script-contracts:sync": "node cli/script-contracts.mjs sync",
    "script-contracts:check": "node cli/script-contracts.mjs check",
    "runtime-bootstrap:sync": "node cli/runtime-bootstrap.mjs sync",
    "runtime-bootstrap:check": "node cli/runtime-bootstrap.mjs check",
    "gate-decidability:check": "node cli/governance/gate-decidability-check.mjs",
    "ruleset:check": "npm run build && node cli/ruleset-check.mjs",
    "review:check": "npm run build && node cli/review-check.mjs",
    "insights:check": "npm run build && node cli/insights-check.mjs",
    "intent:check": "npm run build && node cli/intent-check.mjs",
    "disclosure": "npm run build && node cli/disclosure-render.mjs",
    "validate": "npm run format:check && npm run build:all && npm run script-contracts:check && npm run runtime-bootstrap:check && npm run test && npm run living-docs:check && npm run state-yml:check && npm run active-specs:check && npm run reconcile:check && npm run co-knowledge:check && npm run co-knowledge:inventory && npm run gate-decidability:check && npm run ruleset:check && npm run review:check && npm run insights:check && npm run intent:check",
    "ci": "npm ci && npm run validate && npm run state-yml:check:all && npm run test:smoke",
    "prepare": "husky",
    "prepack": "npm run build:all"
  },
  "devDependencies": {
    "@inquirer/testing": "^3.3.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.6.2",
    "@types/yaml": "^1.9.7",
    "husky": "^9.1.7",
    "jest": "^30.4.2",
    "jest-util": "^30.4.1",
    "lint-staged": "^17.0.5",
    "prettier": "^3.0.0",
    "ts-jest": "^29.4.9",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@inquirer/prompts": "7.8.4",
    "yaml": "^2.8.4"
  }
}
