{
  "name": "org-sim-v2-viewer",
  "private": true,
  "type": "module",
  "description": "Viewer do banco derivado (sim v2) — lê public/snapshot.json gerado por _banks/run.ts.",
  "scripts": {
    "dev": "vite",
    "dev:all": "concurrently -k -n api,bank,web \"npm:api\" \"npm:bank:watch\" \"npm:dev\"",
    "api": "node -e \"const fs=require('fs');if(!fs.existsSync('db.json'))fs.copyFileSync('db.seed.json','db.json')\" && json-server --watch db.json --port 5174",
    "bank": "node ../_banks/derive-app.ts",
    "bank:watch": "node ../_banks/derive-app.ts --watch",
    "build": "tsc && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "json-server": "^0.17.4",
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  }
}
