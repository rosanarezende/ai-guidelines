{
  "name": "org-sim-v2-viewer",
  "private": true,
  "type": "module",
  "description": "Viewer da sim v2: dashboards estáticos (render-dashboards.tsx lê os db.json de _lib/build.ts) + a app de autoria LEGADA (dev/api).",
  "scripts": {
    "dev": "vite",
    "dev:all": "concurrently -k -n api,web \"npm:api\" \"npm:dev\"",
    "api": "node ensure-db.mjs && json-server --watch db.json --port 5174",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "dashboards": "tsx render-dashboards.tsx"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "json-server": "^0.17.4",
    "tsx": "^4.22.4",
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  }
}
