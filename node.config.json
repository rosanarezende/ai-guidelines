{
  "$schema": "https://nodejs.org/dist/v24.14.0/docs/node-config-schema.json",
  "testRunner": {
    "experimental-test-coverage": true,
    "test-coverage-lines": 85,
    "test-coverage-exclude": [
      "node_modules/**",
      "dist/**",
      "scratch/**",
      ".specify/**",
      ".pnp.loader.mjs",
      ".pnp.cjs",
      ".yarn/**"
    ]
  }
}
