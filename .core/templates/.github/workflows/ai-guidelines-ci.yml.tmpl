name: {{ci_workflow_name}}

on:
  pull_request:
    branches:
      - main
  push:
    branches:
      - main

jobs:
  ai-guidelines-check:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Setup Node.js
        uses: actions/setup-node@v4
        with:
          node-version: "{{node_version}}"
{{corepack_step}}
      - name: Install dependencies
        run: {{install_command}}

      - name: Validate AI-first baseline
        run: {{check_command}}
