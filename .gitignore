# Dependências Node / Yarn
node_modules/

# Yarn Berry (v2+)
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# Artefatos do Windows/macOS
.DS_Store
Thumbs.db
# Mark-of-the-Web (Alternate Data Stream) — nome com ':' é path inválido no
# Windows e quebra `git checkout`/smoke. NUNCA versionar.
*:Zone.Identifier

# Arquivos de configuração local da IA
.claude/
.antigravitycli/
.aider*
scratch/

# Testes e Linter
coverage/
*-report.txt
checks_ai_guidelines.txt

# Build output do tsc (declarado em tsconfig.json `outDir`)
dist/

# Logs
logs/
*.log

# Arquivos temporários
.tmp/
temp/
# Scripts de scratch na raiz (ex.: cálculo ad-hoc de hash) — nunca versionar.
# O repo usa cli/**/*.test.mjs e src/**/*.test.ts; não há test-*.js de raiz legítimo.
/test-*.js

# Stack dumps do bash em Windows (Git Bash / MSYS)
*.stackdump
